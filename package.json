{
  "name": "perfumes-block",
  "version": "0.1.0",
  "description": "Bloque de WordPress construido con React (Gutenberg) para Perfumes.",
  "author": "Tu Nombre",
  "license": "GPL-2.0-or-later",
  "main": "build/index.js",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "pnpm run build:plugin && pnpm run build:theme && pnpm run build:shop-catalog",
    "build:plugin": "wp-scripts build",
    "build:theme": "tailwindcss -c tailwind.config.js -i ./theme/omar-perfumes/assets/src.css -o ./theme/omar-perfumes/assets/theme.css --minify",
    "build:shop-catalog": "wp-scripts build --config webpack.shop-catalog.config.js",
    "start": "wp-scripts start",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style \"src/**/*.scss\" \"theme/omar-perfumes/assets/src.css\"",
    "lint:js": "wp-scripts lint-js",
    "test:smoke": "node scripts/smoke-storefront.mjs",
    "plugin-zip": "wp-scripts plugin-zip"
  },
  "devDependencies": {
    "@wordpress/browserslist-config": "^6.53.0",
    "@wordpress/scripts": "^30.0.0",
    "@wordpress/stylelint-config": "^24.2.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
