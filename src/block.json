{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "perfumes/showcase",
	"version": "0.1.0",
	"title": "Perfumes Showcase",
	"category": "widgets",
	"icon": "products",
	"description": "Muestra un producto de perfume con imagen, título y descripción.",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "perfumes",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
